 *
 * native_sim CANopen overlay: 把 zephyr_canbus 指向 native_sim 的 can0 (socketcan).
 *
 * 使用 (Linux, 需 vcan + altname):
 *   sudo modprobe vcan
 *   sudo ip link add dev vcan0 type vcan
 *   sudo ip link property add dev vcan0 altname zcan0
 *   sudo ip link set vcan0 up
 *   west build -b native_sim -d build/native samples/canopen \
 *       -DDTC_OVERLAY_FILE=boards/native_sim.overlay
 *   ./build/native/zephyr/zephyr.exe
 *
 * 然后用 cansend/candump (can-utils) 从另一侧交互:
 *   candump zcan0
 *   cansend zcan0 000#    (NMT 启动)
 */

/ {
	chosen {
		zephyr_canbus = &can0;
	};
};

&can0 {
	status = "okay";
};
